rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can only access their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Lent Money subcollection
      match /lentMoney/{transactionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // Borrowed Money subcollection
      match /borrowedMoney/{transactionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // Repayments subcollection
      match /repayments/{repaymentId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // Savings Goals subcollection
      match /savingsGoals/{goalId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}